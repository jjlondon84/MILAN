# Copia este archivo como .env y pon tus datos
SPRING_DATASOURCE_URL=jdbc:mysql://localhost:3306/barberia_milan?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=America/Bogota&characterEncoding=UTF-8
SPRING_DATASOURCE_USERNAME=root
SPRING_DATASOURCE_PASSWORD=tu_clave_de_mysql

# Genera una con:  openssl rand -base64 32   (o en PowerShell: [Convert]::ToBase64String((1..32|%{Get-Random -Max 256})))
APP_AES_KEY=pon_aqui_una_clave_base64_de_32_bytes

APP_ADMIN_USUARIO=admin
APP_ADMIN_CONTRASENA=Milan2026*
APP_ADMIN_NOMBRE=Administrador MILAN
APP_ADMIN_EMAIL=admin@milanbarberia.co
